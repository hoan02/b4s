{
  "$schema": "https://schema.tauri.app/config/2/capability",
  "identifier": "default",
  "description": "Default capabilities for B4S",
  "windows": ["main"],
  "permissions": [
    "core:default",
    { "identifier": "opener:allow-open-url", "allow": [{ "url": "https://github.com/hoan02/b4s" }] },
    "log:allow-log",
    "store:allow-load",
    "store:allow-get",
    "store:allow-set",
    "store:allow-save",
    "updater:default"
  ]
}
